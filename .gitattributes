# 统一行尾：仓库内存 LF，避免跨平台 diff 噪音
* text=auto eol=lf

# 源码与文本
*.py   text eol=lf
*.md   text eol=lf diff=markdown
*.json text eol=lf
*.jsonl text eol=lf
*.txt  text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Windows 批处理必须 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制：不做行尾转换、不做文本 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.xlsx binary
*.docx binary
